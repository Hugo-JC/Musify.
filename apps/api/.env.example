# Chave da API oficial YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Audius API key (opcional para endpoints de leitura; aumenta os limites)
AUDIUS_API_KEY=

# Google OAuth 2.0 (para ligação de conta de utilizador verificado do YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# URL do frontend para redirecionamento após autenticação
FRONTEND_URL=http://localhost:3000

# Cache Redis (opcional; usa fallback em memória se indisponível)
REDIS_URL=redis://localhost:6379/0
