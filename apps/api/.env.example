# Chave da API oficial YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=AIzaSy...

# Google OAuth 2.0 (para ligação de conta de utilizador verificado do YouTube)
GOOGLE_CLIENT_ID=seu-id-de-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# URL do frontend para redirecionamento após autenticação
FRONTEND_URL=http://localhost:3000

# Cache Redis (opcional, utiliza cache em memória por defeito se ausente)
REDIS_URL=redis://localhost:6379/0
